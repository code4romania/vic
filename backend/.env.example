DATABASE_HOST=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_PORT=
# Database used by specs that need Postgres (local only, created if missing)
DATABASE_TEST_NAME=vic_test

# Global rate limit per client IP: THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds.
# Required (with MAIL_FROM, CACHE_TTL, AWS_S3_BUCKET_NAME_PUBLIC) in staging and production; local defaults otherwise.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

TYPEORM_DEBUG=
# Apply pending migrations at boot (default true). false on deployed services: run `npm run migration:run:prod` once per deploy.
RUN_MIGRATIONS=true
PORT=
NODE_ENV=

REDIS_HOST=
REDIS_PORT=
CACHE_TTL=

# Queue board at /admin/queues (Bull Board). Off unless BULL_BOARD_ENABLED=true, and then it is mounted only
# when both credentials are set (basic auth). It shows job data, including the emails with login links and
# codes waiting to be sent: keep it off in production, or on only behind a strong password.
BULL_BOARD_ENABLED=false
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_CONTACT=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=
# Optional, local only: an S3-compatible emulator (docker: adobe/s3mock on :9090) instead of AWS.
# Staging and production leave these unset. AWS_S3_BUCKET_NAME_PUBLIC holds the public bucket's host.
AWS_S3_BUCKET_NAME_PUBLIC=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

EXPO_PUSH_NOTIFICATIONS_ACCESS_TOKEN=

# Own authentication (docs/auth.md has the key generation commands)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS_WEB=7
REFRESH_TTL_DAYS_MOBILE=30
AUTH_TOKEN_KEY=
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MOBILE_MIN_VERSION=1.0.19
MAINTENANCE_MODE=false
MAINTENANCE_ALLOWED_IPS=
TURNSTILE_SECRET=
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=org.commitglobal.vic
# Services ID used by Sign in with Apple on the web (comma separated if more than one)
APPLE_SERVICES_ID=
# Sign in with Apple key (Certificates, IDs & Profiles > Keys) to revoke Apple tokens when an account
# is deleted (App Store 5.1.1(v)). Optional: without all three nothing is exchanged or revoked.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# the .p8 file, base64 encoded on one line
APPLE_PRIVATE_KEY=
# only if the web Sign in with Apple uses a redirect URI
APPLE_WEB_REDIRECT_URI=
REDIS_KEY_PREFIX=
