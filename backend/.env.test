# Overrides for the e2e suite (npm run test:e2e), loaded by test/setup-env.ts on top of .env.
# No secrets here: the RSA key pair and AUTH_TOKEN_KEY are generated in memory for every run, and
# the database is the local vic_test_<worker> (test/utils/test-data-source.ts refuses non-local hosts).
NODE_ENV=local
REDIS_KEY_PREFIX=test:
# Queues of their own: without this a test app's mail worker took (and dropped) a dev server's email jobs.
BULL_PREFIX=test-bull
MAINTENANCE_MODE=false
TYPEORM_DEBUG=0
