{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "modules/mail/templates/**/*",
      "modules/mail/assets/**/*",
      "modules/volunteer/assets/**/*"
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin",
        "options": {
          "introspectComments": true,
          "dtoFileNameSuffix": [
            ".dto.ts"
          ]
        }
      }
    ]
  }
}
