<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light only" />
  <title>{{title}}</title>
  <style>
    @media (max-width: 620px) {
      .card { padding: 28px 22px !important; }
      .title { font-size: 21px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F6; -webkit-text-size-adjust:100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F3F4F6;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
          {{> header}}
          <tr>
            <td class="card" style="background-color:#FFFFFF; border-radius:16px; padding:36px 40px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#1F2937;">
              <h1 class="title" style="margin:0 0 12px; font-size:24px; line-height:1.3; font-weight:700; color:#111827;">{{title}}</h1>
              <p style="margin:0; font-size:16px; line-height:1.6; color:#4B5563;">{{subtitle}}</p>
              {{#if code}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 4px;">
                <tr>
                  <td class="code" style="background-color:#FEF9E1; border:1px solid #FAD00A; border-radius:12px; padding:14px 24px; font-family:'SFMono-Regular', Menlo, Consolas, monospace; font-size:30px; font-weight:700; letter-spacing:8px; color:#111827;">{{code}}</td>
                </tr>
              </table>
              {{/if}}
              {{#if cta}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 4px;">
                <tr>
                  <td class="cta" style="border-radius:10px; background-color:#FAD00A;">
                    <a href="{{cta.link}}" target="_blank" style="display:inline-block; padding:13px 26px; font-size:16px; font-weight:700; color:#111827; text-decoration:none; border-radius:10px;">{{cta.label}}</a>
                  </td>
                </tr>
              </table>
              <p style="margin:16px 0 0; font-size:12px; line-height:1.5; color:#9CA3AF;">Dacă butonul nu merge, copiază linkul în browser:<br /><a href="{{cta.link}}" target="_blank" style="color:#6B7280; word-break:break-all;">{{cta.link}}</a></p>
              {{/if}}
              {{#if english}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:32px;">
                <tr><td class="divider" style="border-top:1px solid #E5E7EB; padding-top:24px;">
                  <p style="margin:0 0 6px; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#9CA3AF;">English</p>
                  <p style="margin:0 0 6px; font-size:16px; font-weight:700; color:#374151;">{{english.title}}</p>
                  <p style="margin:0; font-size:14px; line-height:1.6; color:#6B7280;">{{english.subtitle}}</p>
                </td></tr>
              </table>
              {{/if}}
            </td>
          </tr>
          {{> footer}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
