EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PRIVACY_POLICY_LINK=
EXPO_PUBLIC_TERMS_AND_CONDITIONS_LINK=
EXPO_PUBLIC_INFORMATION_LINK=
EXPO_PUBLIC_CONTACT_EMAIL=

# Social sign-in. The backend checks the Google tokens against GOOGLE_CLIENT_IDS and the Facebook
# ones against FACEBOOK_APP_ID. Without the Google iOS client id / Facebook app id, app.config.ts
# leaves out the native setup of that provider.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Build-time only (read by app.config.ts, not shipped as EXPO_PUBLIC_)
FACEBOOK_CLIENT_TOKEN=

# Update required / Open the app screens
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=org.commitglobal.vic
# Login shows the "had an account before?" notice until this date (YYYY-MM-DD)
EXPO_PUBLIC_MIGRATION_NOTICE_UNTIL=

# Path to google-services.json (Android push)
GOOGLE_SERVICES_JSON=
