        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "",
        "EXPO_PUBLIC_APP_STORE_URL": "",
        "EXPO_PUBLIC_PLAY_STORE_URL": "https://play.google.com/store/apps/details?id=org.commitglobal.vic",
        "EXPO_PUBLIC_MIGRATION_NOTICE_UNTIL": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_API_URL": "https://api-vic-staging.ngohub.ro",
