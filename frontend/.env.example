VITE_API_URL=
VITE_APP_FRONTEND_URL=
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
# Until this date (YYYY-MM-DD) the login page shows the "new login" notice for people who had an account.
VITE_MIGRATION_NOTICE_UNTIL=
# VIC terms and privacy policy, linked from the NGO registration form (issue 21) and Settings > Despre.
# REQUIRED in every deployed environment: without them the mandatory "I accept" checkbox at NGO
# registration shows no links to what is being accepted.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
# Settings > Despre (#509): help center
VITE_HELP_CENTER_URL=
# Social login on the login page (#512); a button appears only when its id is set.
# Google: the Web OAuth client id. Apple: the Services ID; its return URL must be https and registered at Apple.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=
